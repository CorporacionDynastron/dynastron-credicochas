# ============================================================================
#  CREDICOCHA'S v3.0 — Variables de entorno (Plantilla de ejemplo)
#  Este archivo NUNCA debe contener claves reales si se sube a GitHub.
# ============================================================================

# --- OPCIÓN 1: Neon PostgreSQL (Connection String de Neon en Render) --------
DATABASE_URL=

# --- OPCIÓN 2: Variables individuales (pgsql para Neon / mysql para cPanel) -
DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=credicochas_pruebas
DB_USER=postgres
DB_PASS=030524
DB_SSLMODE=disable
DB_CHARSET=utf8

# --- Seguridad CORS (Dominio de Firebase Hosting) ---------------------------
CORS_ORIGIN=*

# --- Aplicación -------------------------------------------------------------
APP_TIMEZONE=America/Lima
APP_DEBUG=false
MORA_FEE=10
SESSION_HOURS=12

# --- Usuario administrador inicial ------------------------------------------
ADMIN_USER=admin
ADMIN_PASS_INICIAL=123456
